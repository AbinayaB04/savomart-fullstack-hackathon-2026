# Database Configuration
POSTGRES_USER=savomart
POSTGRES_PASSWORD=savomart_secret
POSTGRES_DB=savomart_sitescout
POSTGRES_PORT=5432
DATABASE_URL=postgresql://savomart:savomart_secret@db:5432/savomart_sitescout

# Host Port Mappings for Docker Compose
BACKEND_PORT=8000
FRONTEND_PORT=5173
DB_PORT=5432

# Savomart Stores External API
STORES_API_URL=https://internal-service.savomart.in/bridge/api/store/list?is_operational=True
STORES_API_TOKEN=mock_token_for_dev

# LLM Configuration (options: gemini | openai | anthropic | none)
LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Chennai Bounding Box (Lat: 12.80 - 13.25, Lon: 80.05 - 80.35)
CHENNAI_MIN_LAT=12.80
CHENNAI_MAX_LAT=13.25
CHENNAI_MIN_LON=80.05
CHENNAI_MAX_LON=80.35

# Application Settings
ENVIRONMENT=development
VITE_API_BASE_URL=http://localhost:8000
